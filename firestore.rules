rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==================== ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ ====================
    
    // Проверка авторизации пользователя
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Проверка, является ли пользователь владельцем документа
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Получение роли текущего пользователя из базы данных
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    
    // Проверка роли администратора
    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'ADMIN';
    }
    
    // Проверка роли тренера
    function isTrainer() {
      return isAuthenticated() && getUserRole() == 'TRAINER';
    }
    
    // Проверка роли клиента
    function isClient() {
      return isAuthenticated() && getUserRole() == 'CLIENT';
    }
    
    // Проверка, является ли пользователь админом или тренером
    function isStaff() {
      return isAdmin() || isTrainer();
    }
    
    // Проверка, что клиент только записывается или отменяет запись на тренировку
    // (изменяет только participantIds и currentParticipants)
    function isSignUpOrCancelUpdate() {
      let allowedFields = ['participantIds', 'currentParticipants'];
      let changedFields = request.resource.data.diff(resource.data).affectedKeys();
      return changedFields.hasOnly(allowedFields);
    }
    
    // ==================== ПОЛЬЗОВАТЕЛИ (users) ====================
    match /users/{userId} {
      // Чтение: собственный профиль, админ или тренер (для списка клиентов)
      allow read: if isOwner(userId) || isAdmin() || isTrainer();
      
      // Создание: при регистрации (uid совпадает) или админ создаёт пользователя
      allow create: if isOwner(userId) || isAdmin();
      
      // Обновление: собственный профиль или админ
      allow update: if isOwner(userId) || isAdmin();
      
      // Удаление: только админ
      allow delete: if isAdmin();
    }
    
    // ==================== ШАБЛОНЫ АБОНЕМЕНТОВ (subscriptions) ====================
    match /subscriptions/{subscriptionId} {
      // Чтение: все авторизованные пользователи (для отображения списка абонементов)
      allow read: if isAuthenticated();
      
      // Создание, обновление, удаление: только админ
      allow create, update, delete: if isAdmin();
    }
    
    // ==================== КУПЛЕННЫЕ АБОНЕМЕНТЫ (user_subscriptions) ====================
    match /user_subscriptions/{subscriptionId} {
      // Чтение: владелец абонемента или админ
      allow read: if isAuthenticated() && 
        (resource.data.userId == request.auth.uid || isAdmin());
      
      // Создание: пользователь может купить абонемент для себя, или админ
      allow create: if isAuthenticated() && 
        (request.resource.data.userId == request.auth.uid || isAdmin());
      
      // Обновление: владелец или админ
      allow update: if isAuthenticated() && 
        (resource.data.userId == request.auth.uid || isAdmin());
      
      // Удаление: только админ
      allow delete: if isAdmin();
    }
    
    // ==================== ТРЕНЕРЫ (trainers) ====================
    match /trainers/{trainerId} {
      // Чтение: все авторизованные пользователи (для отображения списка тренеров)
      allow read: if isAuthenticated();
      
      // Создание, обновление, удаление: только админ
      allow create, update, delete: if isAdmin();
    }
    
    // ==================== ТРЕНИРОВКИ (group_workouts) ====================
    // Включает как групповые, так и индивидуальные тренировки
    match /group_workouts/{workoutId} {
      // Чтение: все авторизованные пользователи
      allow read: if isAuthenticated();
      
      // Создание: админ/тренер или клиент записывает индивидуальную тренировку на себя
      allow create: if isStaff() ||
        (isClient() && request.resource.data.isIndividual == true &&
         request.resource.data.clientId == request.auth.uid);
      
      // Обновление: админ, тренер (своих тренировок) или клиент (запись/отмена записи на тренировку)
      allow update: if isAdmin() || 
        (isTrainer() && resource.data.trainerId == request.auth.uid) ||
        // Клиент может обновить свою индивидуальную тренировку
        (isClient() && resource.data.clientId == request.auth.uid) ||
        // Клиент может записаться на групповую тренировку (добавить/удалить себя из participantIds)
        (isClient() && isSignUpOrCancelUpdate());
      
      // Удаление: админ или клиент отменяет свою индивидуальную тренировку
      allow delete: if isAdmin() ||
        (isClient() && resource.data.isIndividual == true &&
         resource.data.clientId == request.auth.uid);
    }
    
    // ==================== РАСПИСАНИЕ ТРЕНЕРОВ (trainer_availability) ====================
    match /trainer_availability/{availabilityId} {
      // Чтение: все авторизованные пользователи (клиенты видят расписание для записи)
      allow read: if isAuthenticated();
      
      // Создание: тренер создаёт своё расписание или админ
      allow create: if isAdmin() || 
        (isTrainer() && request.resource.data.trainerId == request.auth.uid);
      
      // Обновление: тренер или админ
      allow update: if isAdmin() || 
        (isTrainer() && resource.data.trainerId == request.auth.uid);
      
      // Удаление: тренер может удалить своё расписание или админ
      allow delete: if isAdmin() || 
        (isTrainer() && resource.data.trainerId == request.auth.uid);
    }
    
    // ==================== ЧАТЫ (chats) ====================
    match /chats/{messageId} {
      // Чтение: все авторизованные пользователи (фильтрация по chatId на уровне приложения)
      allow read: if isAuthenticated();
      
      // Создание: авторизованный пользователь может отправить сообщение от своего имени
      allow create: if isAuthenticated() && 
        request.resource.data.senderId == request.auth.uid;
      
      // Обновление: пометка прочитанным
      allow update: if isAuthenticated();
      
      // Удаление: автор или админ
      allow delete: if isAuthenticated() && 
        (resource.data.senderId == request.auth.uid || isAdmin());
    }
    
    // ==================== ЗАПИСИ НА ТРЕНИРОВКИ (workout_registrations) ====================
    match /workout_registrations/{registrationId} {
      // Чтение: владелец записи, тренер тренировки или админ
      allow read: if isAuthenticated() && 
        (resource.data.userId == request.auth.uid || isStaff());
      
      // Создание: клиент записывается сам или админ/тренер записывает клиента
      allow create: if isAuthenticated() && 
        (request.resource.data.userId == request.auth.uid || isStaff());
      
      // Обновление: владелец записи, тренер или админ
      allow update: if isAuthenticated() && 
        (resource.data.userId == request.auth.uid || isStaff());
      
      // Удаление: владелец записи (отмена), тренер или админ
      allow delete: if isAuthenticated() && 
        (resource.data.userId == request.auth.uid || isStaff());
    }
    
    // ==================== ОТЗЫВЫ (reviews) ====================
    match /reviews/{reviewId} {
      // Чтение: все авторизованные пользователи
      allow read: if isAuthenticated();
      
      // Создание: авторизованный пользователь может оставить отзыв
      allow create: if isAuthenticated() && 
        request.resource.data.userId == request.auth.uid;
      
      // Обновление: автор отзыва или админ
      allow update: if isAuthenticated() && 
        (resource.data.userId == request.auth.uid || isAdmin());
      
      // Удаление: автор отзыва или админ
      allow delete: if isAuthenticated() && 
        (resource.data.userId == request.auth.uid || isAdmin());
    }
    
    // ==================== УВЕДОМЛЕНИЯ (notifications) ====================
    match /notifications/{notificationId} {
      // Чтение: получатель уведомления или админ
      allow read: if isAuthenticated() && 
        (resource.data.userId == request.auth.uid || isAdmin());
      
      // Создание: админ или система (тренер для своих клиентов)
      allow create: if isStaff();
      
      // Обновление: получатель (отметка прочитанным) или админ
      allow update: if isAuthenticated() && 
        (resource.data.userId == request.auth.uid || isAdmin());
      
      // Удаление: получатель или админ
      allow delete: if isAuthenticated() && 
        (resource.data.userId == request.auth.uid || isAdmin());
    }
    
    // ==================== НАСТРОЙКИ ПРИЛОЖЕНИЯ (app_settings) ====================
    match /app_settings/{settingId} {
      // Чтение: все авторизованные пользователи
      allow read: if isAuthenticated();
      
      // Запись: только админ
      allow write: if isAdmin();
    }
  }
}
