rules_version = '2';

// =============================================================================
//  HypeSportClub — Firestore Security Rules
//  Коллекции:
//   • users            (CLIENT / TRAINER / ADMIN / MANAGER)
//   • subscriptions    (шаблоны абонементов)
//   • user_subscriptions (выданные / купленные клиентом)
//   • trainers         (карточки тренеров)
//   • group_workouts   (групповые + индивидуальные тренировки)
//   • trainer_availability (слоты доступности тренера)
//   • training_requests (заявки на индивидуальную тренировку)
//   • workout_registrations (записи на групповые тренировки)
//   • chats            (плоская коллекция сообщений с полем chatId)
//   • food_entries     (дневник питания / БЖУ)
//   • users/{uid}/nutritionHistory (история BMR-расчётов)
//   • expenses, revenues (финансы)
//   • reviews, notifications, app_settings
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ==================== ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ ====================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Безопасное получение роли: exists() защищает от краша при отсутствии документа
    function getUserRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', null)
        : null;
    }

    function isAdmin()   { return isAuthenticated() && getUserRole() == 'ADMIN'; }
    function isTrainer() { return isAuthenticated() && getUserRole() == 'TRAINER'; }
    function isClient()  { return isAuthenticated() && getUserRole() == 'CLIENT'; }
    function isManager() { return isAuthenticated() && getUserRole() == 'MANAGER'; }

    // Персонал: администратор, тренер или менеджер
    function isStaff() { return isAdmin() || isTrainer() || isManager(); }

    // Клиент изменяет только список участников групповой тренировки
    function isSignUpOrCancelUpdate() {
      let allowedFields = ['participantIds', 'currentParticipants'];
      let changedFields = request.resource.data.diff(resource.data).affectedKeys();
      return changedFields.hasOnly(allowedFields);
    }

    // ==================== ПОЛЬЗОВАТЕЛИ (users) ====================
    match /users/{userId} {
      // Чтение: свой профиль, или персонал (для списков)
      allow read:   if isOwner(userId) || isAdmin() || isTrainer() || isManager();
      // Создание: при регистрации (uid совпадает) или персонал управления
      allow create: if isOwner(userId) || isAdmin() || isManager();
      // Обновление: свой профиль или персонал управления
      allow update: if isOwner(userId) || isAdmin() || isManager();
      // Удаление: только администратор
      allow delete: if isAdmin();

      // История BMR-расчётов (заполняется клиентом или Cloud Function)
      match /nutritionHistory/{entryId} {
        allow read:          if isOwner(userId) || isAdmin();
        allow create:        if isOwner(userId) || isAdmin();
        allow update, delete: if isAdmin();
      }
    }

    // ==================== ШАБЛОНЫ АБОНЕМЕНТОВ (subscriptions) ====================
    match /subscriptions/{subscriptionId} {
      // Чтение: все авторизованные пользователи
      allow read: if isAuthenticated();
      // Создание и обновление: администратор или менеджер
      allow create, update: if isAdmin() || isManager();
      // Удаление: только администратор
      allow delete: if isAdmin();
    }

    // ==================== КУПЛЕННЫЕ АБОНЕМЕНТЫ (user_subscriptions) ====================
    match /user_subscriptions/{subscriptionId} {
      // Чтение: владелец, администратор или менеджер
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin() || isManager());

      // Создание: клиент покупает себе, или администратор/менеджер выдаёт
      allow create: if isAuthenticated() &&
        (request.resource.data.userId == request.auth.uid || isAdmin() || isManager());

      // Обновление: владелец (без смены userId) или администратор
      allow update: if isAuthenticated() &&
        ((resource.data.userId == request.auth.uid &&
          request.resource.data.userId == resource.data.userId) || isAdmin());

      // Удаление: только администратор
      allow delete: if isAdmin();
    }

    // ==================== ТРЕНЕРЫ (trainers) ====================
    match /trainers/{trainerId} {
      // Чтение: все авторизованные пользователи
      allow read: if isAuthenticated();
      // Создание и удаление: только администратор
      allow create, delete: if isAdmin();
      // Обновление: администратор или тренер своей карточки
      allow update: if isAdmin() ||
        (isTrainer() && resource.data.userId == request.auth.uid);
    }

    // ==================== ТРЕНИРОВКИ (group_workouts) ====================
    // Охватывает как групповые, так и индивидуальные тренировки
    match /group_workouts/{workoutId} {
      allow read: if isAuthenticated();

      // Создание: персонал, или клиент создаёт индивидуальную на себя
      allow create: if isStaff() ||
        (isClient() && request.resource.data.isIndividual == true &&
         request.resource.data.clientId == request.auth.uid);

      // Обновление: админ; тренер своих; клиент своей индивидуальной или запись/отмена на групповую
      allow update: if isAdmin() ||
        (isTrainer() && resource.data.trainerId == request.auth.uid) ||
        (isClient() && resource.data.clientId == request.auth.uid) ||
        (isClient() && isSignUpOrCancelUpdate());

      // Удаление: администратор или клиент отменяет свою индивидуальную
      allow delete: if isAdmin() ||
        (isClient() && resource.data.isIndividual == true &&
         resource.data.clientId == request.auth.uid);
    }

    // ==================== РАСПИСАНИЕ ТРЕНЕРОВ (trainer_availability) ====================
    match /trainer_availability/{availabilityId} {
      allow read: if isAuthenticated();

      // Создание: пользователь, чей uid совпадает с trainerId, или администратор
      // (uid-matching вместо проверки роли — надёжнее при разных типах ID тренера)
      allow create: if isAuthenticated() &&
        (request.resource.data.trainerId == request.auth.uid || isAdmin());

      // Обновление и удаление: владелец слота или администратор
      allow update, delete: if isAuthenticated() &&
        (resource.data.trainerId == request.auth.uid || isAdmin());
    }

    // ==================== ЗАЯВКИ НА ТРЕНИРОВКУ (training_requests) ====================
    match /training_requests/{reqId} {
      allow read: if isAuthenticated() &&
        (resource.data.clientId == request.auth.uid ||
         resource.data.trainerId == request.auth.uid || isStaff());

      allow create: if isAuthenticated() &&
        request.resource.data.clientId == request.auth.uid;

      allow update: if isAuthenticated() &&
        (resource.data.trainerId == request.auth.uid ||
         resource.data.clientId == request.auth.uid || isAdmin());

      allow delete: if isAdmin() ||
        (isAuthenticated() && resource.data.clientId == request.auth.uid);
    }

    // ==================== ЗАПИСИ НА ТРЕНИРОВКИ (workout_registrations) ====================
    match /workout_registrations/{registrationId} {
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isStaff());

      allow create: if isAuthenticated() &&
        (request.resource.data.userId == request.auth.uid || isStaff());

      allow update: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isStaff());

      allow delete: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isStaff());
    }

    // ==================== ЧАТЫ (chats) ====================
    // Каждый документ — одно сообщение; chatId связывает диалог двух пользователей
    match /chats/{messageId} {
      // Чтение: любой авторизованный (фильтрация по chatId на уровне приложения)
      allow read: if isAuthenticated();

      // Создание: отправитель совпадает с uid; chatId должен содержать uid отправителя
      allow create: if isAuthenticated() &&
        request.resource.data.senderId == request.auth.uid &&
        request.resource.data.chatId.matches('.*' + request.auth.uid + '.*');

      // Обновление: только пометка прочитанным (поле isRead)
      allow update: if isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);

      // Удаление: автор или администратор
      allow delete: if isAuthenticated() &&
        (resource.data.senderId == request.auth.uid || isAdmin());
    }

    // ==================== БЖУ ДНЕВНИК (food_entries) ====================
    match /food_entries/{entryId} {
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;

      // Обновление: владелец записи
      allow update: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;

      allow delete: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin());
    }

    // ==================== ОТЗЫВЫ (reviews) ====================
    match /reviews/{reviewId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;

      allow update, delete: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin());
    }

    // ==================== УВЕДОМЛЕНИЯ (notifications) ====================
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if isStaff();

      allow update, delete: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin());
    }

    // ==================== ФИНАНСЫ (expenses, revenues) ====================
    // Доступно только администратору и менеджеру
    match /expenses/{docId} {
      allow read, create, update, delete: if isAdmin() || isManager();
    }

    match /revenues/{docId} {
      allow read, create, update, delete: if isAdmin() || isManager();
    }

    // ==================== НАСТРОЙКИ ПРИЛОЖЕНИЯ (app_settings) ====================
    match /app_settings/{settingId} {
      allow read:  if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
